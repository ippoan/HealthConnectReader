<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect 読取権限 (本アプリで使う 3 種) -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <!-- 過去 30 日 (grant 時から) 以前のデータを読むには history permission が必須
         (Android 14+ HC 仕様)。issue #6 「過去 30 日 Upload」要件のため追加。 -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- WebView + worker への HTTPS POST 用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- アプリ内自動更新: DL した APK をインストーラに渡すため。Android 8+ は
         さらに端末側で「このアプリからのインストール」許可が要る (未許可時は
         MainActivity が ACTION_MANAGE_UNKNOWN_APP_SOURCES へ誘導する)。Refs #30 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 13 以下で Health Connect アプリ (com.google.android.apps.healthdata) を
         クエリできるようにする (Android 14+ では Health Connect が OS 同梱なので不要だが
         後方互換のため記載) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="HealthConnectReader"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect が「権限がなぜ必要か」説明画面を呼び出すための
                 rationale intent。要件なので必ず宣言する。 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Android 14+ (API 34+) で HC 権限リクエストを通すには Activity に
                 VIEW_PERMISSION_USAGE + HEALTH_PERMISSIONS の intent-filter を
                 宣言する必要がある。無いと PermissionController が起動する
                 権限 UI が silent fail でダイアログが出ない (Refs #25)。
                 Android 13 までは不要だったが OS 同梱になった 14+ で必須化。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- 自動更新で DL した APK を content:// URI でインストーラに渡すための
             FileProvider。external-files-path (= getExternalFilesDir) 配下のみ公開。
             Refs #30 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
